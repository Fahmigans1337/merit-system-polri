# ================================================================
# Merit SDM Personel Polri - Environment Variables (OPSIONAL)
#
# Aplikasi berjalan TANPA file .env: default-nya SQLite lokal, tabel dan
# data awal dibuat otomatis saat start. Salin file ini hanya jika ingin
# mengganti nilai:  cp .env.example .env
# ================================================================

# --- DATABASE ---
# Default (tanpa konfigurasi): SQLite file lokal
# DATABASE_URL=sqlite:///./merit_polri.db

# PostgreSQL (awalan HARUS postgresql+psycopg2://)
# DATABASE_URL=postgresql+psycopg2://merituser:merit2026@localhost:5432/merit_polri

# --- AUTO SETUP ---
# true  : saat start, tunggu database -> buat tabel -> isi data awal bila kosong
# false : lewati (mis. jika memakai migrasi Alembic sendiri)
AUTO_SETUP=true

# --- JWT SECURITY ---
# WAJIB diganti jika dipakai di luar lingkungan uji
SECRET_KEY=merit-system-polri-secret-key-2026-CHANGE-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- APP ---
DEBUG=False
