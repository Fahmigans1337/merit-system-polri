# ================================================================
# Merit System Personel Polri - Environment Variables
# Salin file ini: copy .env.example .env
# Sesuaikan nilainya sebelum menjalankan aplikasi
# ================================================================

# --- DATABASE ---
# PostgreSQL (Docker / Production) - DEFAULT
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/merit_polri

# SQLite (Local development tanpa Docker) - uncomment baris ini
# DATABASE_URL=sqlite:///./merit_polri.db

# --- JWT SECURITY ---
# WAJIB diganti di production!
SECRET_KEY=merit-system-polri-secret-key-2026-CHANGE-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- APP ---
DEBUG=False
